{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the GeoLock main window (the React UI).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-backend-info",
    "allow-backend-restart",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    },
    "opener:allow-reveal-item-in-dir",
    "window-state:default"
  ]
}
